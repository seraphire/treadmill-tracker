<Window x:Class="TreadmillApp.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="340" Height="108"
        ResizeMode="NoResize">

    <Window.Resources>
        <DoubleAnimation x:Key="FadeIn"  From="0" To="1"   Duration="0:0:0.25"/>
        <DoubleAnimation x:Key="FadeOut" From="1" To="0"   Duration="0:0:0.4"/>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="10"
            BorderBrush="#3A3A5C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="12" x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ImageColumn" Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" x:Name="ToastImage"
                   Source="pack://application:,,,/images/running.png"
                   Width="64" Height="64"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Clip="{x:Null}"/>

            <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Foreground="White" FontWeight="Bold" FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MessageText"
                           Foreground="#AAAACC" FontSize="11"
                           TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
