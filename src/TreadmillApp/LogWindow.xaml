<Window x:Class="TreadmillApp.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostic Log"
        Width="780" Height="520"
        MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#666666" TextWrapping="Wrap"
                   Text="Live diagnostic output from the BLE manager, Strava service, and session tracker. Useful for troubleshooting; not normally needed."/>

        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="LogList"
                     FontFamily="Consolas" FontSize="11"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy All" MinWidth="90" Padding="14,6" Margin="0,0,8,0"
                    Click="CopyAll_Click"/>
            <Button Content="Clear" MinWidth="90" Padding="14,6" Margin="0,0,8,0"
                    Click="Clear_Click"/>
            <Button Content="Close" MinWidth="90" Padding="14,6"
                    IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
