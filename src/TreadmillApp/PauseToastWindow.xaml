<Window x:Class="TreadmillApp.PauseToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="400" Height="156"
        ResizeMode="NoResize">

    <Border Background="#1E1E2E" CornerRadius="10"
            BorderBrush="#3A3A5C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="pack://application:,,,/images/sleeping.png"
                   Width="76" Height="76"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Clip="{x:Null}"/>

            <Grid Grid.Column="1" Margin="10,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Foreground="White" FontWeight="Bold" FontSize="13"
                               Text="Walk Paused"/>
                    <TextBlock x:Name="MessageText"
                               Foreground="#AAAACC" FontSize="11"
                               TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="HideButton"   Content="Hide"
                            MinWidth="64" Padding="10,4" Margin="0,0,6,0"
                            Click="Hide_Click"/>
                    <Button x:Name="FinishButton" Content="Finish"
                            MinWidth="64" Padding="10,4"
                            Click="Finish_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
