<Window x:Class="TreadmillApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TreadmillApp"
        Title="Treadmill Tracker" Height="900" Width="560"
        MinHeight="680" MinWidth="460"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="MetricUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DailyMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#5566AA"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DailyMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="DailyMetricUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5566AA"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="82"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Menu bar -->
            <RowDefinition Height="*"/>     <!-- Body -->
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Menu Grid.Row="0" Background="#F4F4F4" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_Stats..."    Click="Stats_Click"    InputGestureText="Ctrl+T"/>
                <MenuItem Header="_Settings..." Click="Settings_Click" InputGestureText="Ctrl+,"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="View _Log..." Click="ViewLog_Click"/>
                <Separator/>
                <MenuItem Header="_About"       Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
            <RowDefinition Height="Auto"/>  <!-- Live metrics -->
            <RowDefinition Height="Auto"/>  <!-- Daily stats -->
            <RowDefinition Height="*"/>     <!-- Activity list -->
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="4" Padding="10,7" Margin="0,0,0,8" Background="#F8F8F8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#AAAAAA"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="LastDeviceHint" Text="" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="#888888" FontSize="10"/>
            </Grid>
        </Border>

        <!-- Control buttons -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="QuickConnectButton" Content="Quick Connect" Style="{StaticResource ActionButton}" IsEnabled="False" Click="QuickConnect_Click"/>
                <Button x:Name="DisconnectButton"   Content="Disconnect"    Style="{StaticResource ActionButton}" IsEnabled="False" Click="Disconnect_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StatsButton"      Content="Stats"           Style="{StaticResource ActionButton}" Click="Stats_Click"/>
                <Button x:Name="FindDeviceButton" Content="Find Device..."  Style="{StaticResource ActionButton}" Margin="0" Click="FindDevice_Click"/>
            </StackPanel>
        </Grid>

        <!-- Live metrics panel -->
        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Speed -->
                <StackPanel Grid.Column="0" Margin="0,0,0,4">
                    <TextBlock Text="SPEED" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="SpeedValue" Text="--" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="km/h" Style="{StaticResource MetricUnit}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#DDDDDD" Margin="0,6"/>

                <!-- Distance -->
                <StackPanel Grid.Column="2" Margin="0,0,0,4">
                    <TextBlock Text="DISTANCE" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="DistanceValue" Text="--" Style="{StaticResource MetricValue}"/>
                    <TextBlock x:Name="DistanceUnit" Text="meters" Style="{StaticResource MetricUnit}"/>
                </StackPanel>

                <Border Grid.Column="3" Background="#DDDDDD" Margin="0,6"/>

                <!-- Steps -->
                <StackPanel Grid.Column="4" Margin="0,0,0,4">
                    <TextBlock x:Name="StepsLabel" Text="STEPS" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="StepsValue" Text="--" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="steps" Style="{StaticResource MetricUnit}"/>
                </StackPanel>

                <Border Grid.Column="5" Background="#DDDDDD" Margin="0,6"/>

                <!-- Calories -->
                <StackPanel Grid.Column="6" Margin="0,0,0,4">
                    <TextBlock Text="CALORIES" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="CaloriesValue" Text="--" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="kcal" Style="{StaticResource MetricUnit}"/>
                </StackPanel>

                <Border Grid.Column="7" Background="#DDDDDD" Margin="0,6"/>

                <!-- Elapsed -->
                <StackPanel Grid.Column="8" Margin="0,0,0,4">
                    <TextBlock Text="ELAPSED" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="ElapsedValue" Text="--" Style="{StaticResource MetricValue}"/>
                    <TextBlock x:Name="ElapsedUnit" Text="time" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Daily totals panel -->
        <Border Grid.Row="3" BorderBrush="#C0C8E8" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,8" Padding="16,10"
                Background="#F0F4FF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Daily distance -->
                <StackPanel Grid.Column="0" Margin="0,0,0,2">
                    <TextBlock Text="TODAY KM" Style="{StaticResource DailyMetricLabel}"/>
                    <TextBlock x:Name="DailyKmBigValue" Text="0.00" Style="{StaticResource DailyMetricValue}"/>
                    <TextBlock Text="km" Style="{StaticResource DailyMetricUnit}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#C0C8E8" Margin="0,4"/>

                <!-- Daily steps -->
                <StackPanel Grid.Column="2" Margin="0,0,0,2">
                    <TextBlock Text="TODAY STEPS" Style="{StaticResource DailyMetricLabel}"/>
                    <TextBlock x:Name="DailyStepsBigValue" Text="0" Style="{StaticResource DailyMetricValue}"/>
                    <TextBlock Text="steps" Style="{StaticResource DailyMetricUnit}"/>
                </StackPanel>

                <Border Grid.Column="3" Background="#C0C8E8" Margin="0,4"/>

                <!-- Daily calories -->
                <StackPanel Grid.Column="4" Margin="0,0,0,2">
                    <TextBlock Text="TODAY CAL" Style="{StaticResource DailyMetricLabel}"/>
                    <TextBlock x:Name="DailyCalBigValue" Text="0" Style="{StaticResource DailyMetricValue}"/>
                    <TextBlock Text="kcal" Style="{StaticResource DailyMetricUnit}"/>
                </StackPanel>

                <Border Grid.Column="5" Background="#C0C8E8" Margin="0,4"/>

                <!-- Daily time -->
                <StackPanel Grid.Column="6" Margin="0,0,0,2">
                    <TextBlock Text="TODAY TIME" Style="{StaticResource DailyMetricLabel}"/>
                    <TextBlock x:Name="DailyTimeBigValue" Text="0" Style="{StaticResource DailyMetricValue}"/>
                    <TextBlock Text="min" Style="{StaticResource DailyMetricUnit}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Activity list -->
        <GroupBox Grid.Row="4" Header="Activity">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Border Grid.Row="0" Background="#F4F4F4" BorderBrush="#DDDDDD"
                        BorderThickness="0,0,0,1" Padding="4,4,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Started"  FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBlock Grid.Column="1" Text="Duration" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBlock Grid.Column="2" Text="Avg km/h" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBlock Grid.Column="3" Text="Steps"    FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBlock Grid.Column="4" Text="Distance" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBlock Grid.Column="5" Text="Status"   FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                    </Grid>
                </Border>

                <!-- Session rows with date separators -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SessionList">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type local:SessionViewModel}">
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="4,5">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Delete walk…"
                                                      Command="{Binding DeleteCommand}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StartDisplay}"    FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DurationDisplay}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AvgSpeedDisplay}" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StepsDisplay}"    FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="{Binding DistanceDisplay}" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="{Binding StatusDisplay}"   FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type local:DateSeparatorItem}">
                                <Border Background="#EEF2FF" BorderBrush="#C0C8E8"
                                        BorderThickness="0,1,0,1" Padding="4,3" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#4455AA"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Daily totals bar -->
                <Border Grid.Row="2" Background="#F8F8F8" BorderBrush="#DDDDDD"
                        BorderThickness="0,1,0,0" Padding="10,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total: " Foreground="#888888" FontSize="11"/>
                            <TextBlock x:Name="DailyDistanceText" Text="0.00 km"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,14,0"/>
                            <TextBlock Text="Steps: " Foreground="#888888" FontSize="11"/>
                            <TextBlock x:Name="DailyStepsText" Text="0"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,14,0"/>
                            <TextBlock Text="Cal: " Foreground="#888888" FontSize="11"/>
                            <TextBlock x:Name="DailyCaloriesText" Text="0"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,14,0"/>
                            <TextBlock Text="Time: " Foreground="#888888" FontSize="11"/>
                            <TextBlock x:Name="DailyTimeText" Text="0 min"
                                       FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="DailyScoreText" Text="0.00 km today"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="13" Foreground="#1A1A2E"/>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        </Grid>
    </Grid>
</Window>
